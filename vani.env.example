# Copy to vani.env and adjust. Paths default to the layout described in pipeline/config.py.
# Vāgdhenu weights (scripts/download_weights.py in the submodule) and an NVIDIA/BigVGAN clone:
CHAMP_ROOT=/path/to/vagdhenu/models
VANI_BIGVGAN=/path/to/BigVGAN
# GPUs to render on (comma-separated); two workers meet in the middle
VANI_GPUS=0,1
# Only if ffmpeg / tectonic are not on PATH, or the source repos are not siblings of this repo:
# VANI_FFMPEG=/opt/ffmpeg/bin/ffmpeg
# VANI_TECTONIC=/opt/tectonic/bin/tectonic
# VANI_STOTRA_SANGRAHAH=/path/to/stotra-sangrahah
# VANI_PUJA_VIDHANAM=/path/to/puja-vidhanam
# Extra library paths needed by torchcodec (NPP) and a non-system ffmpeg:
# LD_LIBRARY_PATH=/path/to/nvidia/npp/lib:/path/to/ffmpeg/lib
